{
  "manifest_version": 3,
  "name": "Terminated User Access Auditor (6-Site Screenshot & Group Checker)",
  "version": "1.0.0",
  "description": "Automates terminated user access verification across PagerDuty, M365 Admin Center, Lucidchart, Bigstock Admin, Shutterstock Inc Person, and Google Sheets with Ctrl+F reporting/tableau checks, screenshots, and audit details.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Terminated User Access Auditor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
